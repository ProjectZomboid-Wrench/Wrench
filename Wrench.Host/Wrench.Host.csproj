<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Emits Wrench.Host.runtimeconfig.json and copies dependencies, as hostfxr needs to load it as a component. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ILVerification" Version="10.0.15" />
        <InternalsVisibleTo Include="Wrench.Host.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JNIBinding\src\JNIBinding\JNIBinding.csproj" />
        <ProjectReference Include="..\Wrench.Api\Wrench.Api.csproj" />
        <ProjectReference Include="..\Wrench.Game\Wrench.Game.csproj" />
    </ItemGroup>

</Project>
