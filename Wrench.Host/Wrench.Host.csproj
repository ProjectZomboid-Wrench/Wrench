<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Emits Wrench.Host.runtimeconfig.json and copies dependencies, as hostfxr needs to load it as a component. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ILVerification" Version="10.0.15" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <InternalsVisibleTo Include="Wrench.Host.Tests" />
        <InternalsVisibleTo Include="Wrench.Samples.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JNIBinding\src\JNIBinding\JNIBinding.csproj" />
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" />
        <PackageReference Include="Wrench.Game.Java" Version="$(WrenchGameJavaVersion)" />
        <PackageReference Include="Wrench.Game.Lua" Version="$(WrenchGameLuaVersion)" />
    </ItemGroup>

</Project>
