        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <PZModId>WrenchFullTrustMod</PZModId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
